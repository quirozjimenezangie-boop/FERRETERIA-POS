<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>¡Mis Primeras Letras!</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Font Fredoka -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Fredoka', cursive, sans-serif;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }
        .bouncy {
            animation: bounce 0.6s infinite alternate;
        }
        @keyframes bounce {
            from { transform: translateY(0); }
            to { transform: translateY(-12px); }
        }
        .pulse-slow {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .shake {
            animation: shake 0.5s ease-in-out;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-10px); }
            40%, 80% { transform: translateX(10px); }
        }
        .bg-pattern {
            background-color: #fdf6e3;
            background-image: radial-gradient(#ffd166 2px, transparent 2px), radial-gradient(#06d6a0 2px, #fdf6e3 2px);
            background-size: 40px 40px;
            background-position: 0 0, 20px 20px;
        }
    </style>
</head>
<body class="bg-pattern min-h-screen flex flex-col justify-between overflow-x-hidden text-slate-800">

    <!-- Encabezado / Barra Superior -->
    <header class="w-full p-4 flex justify-between items-center max-w-4xl mx-auto">
        <div class="flex items-center space-x-3">
            <span class="text-4xl">🎈</span>
            <h1 class="text-2xl md:text-4xl font-bold text-pink-500 tracking-wide drop-shadow-sm">¡Mis Letras!</h1>
        </div>
        <div class="flex items-center space-x-2">
            <!-- Botón de Sonido/Música -->
            <button id="soundToggleBtn" onclick="toggleAudio()" class="bg-yellow-400 hover:bg-yellow-300 text-slate-800 font-bold p-3 md:px-5 md:py-3 rounded-full shadow-lg transform active:scale-95 transition flex items-center space-x-2 border-4 border-white">
                <span id="soundIcon" class="text-2xl">🔊</span>
                <span class="hidden md:inline text-lg">Música</span>
            </button>
        </div>
    </header>

    <!-- Contenido Principal / Contenedor del Juego -->
    <main class="flex-grow flex flex-col justify-center items-center px-4 py-2 max-w-4xl mx-auto w-full">
        
        <!-- Menú Principal (Selección de Modo) -->
        <div id="modeSelection" class="w-full flex flex-col items-center space-y-6 my-auto py-6">
            <h2 class="text-2xl md:text-3xl font-bold text-center text-purple-600 mb-2">¡Vamos a Jugar y Aprender!</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-2xl">
                <!-- Tarjeta Modo 1: Vocales -->
                <button onclick="startMode('learn')" class="bg-gradient-to-b from-pink-400 to-rose-500 hover:from-pink-300 hover:to-rose-400 text-white rounded-3xl p-6 shadow-xl border-4 border-white transform transition active:scale-95 flex flex-col items-center text-center group">
                    <div class="bg-white/30 rounded-2xl p-4 mb-4 transform group-hover:scale-110 transition duration-300">
                        <span class="text-6xl md:text-7xl">🅰️</span>
                    </div>
                    <span class="text-2xl md:text-3xl font-bold drop-shadow">Aprende Vocales</span>
                    <span class="text-sm md:text-base mt-2 opacity-90 font-medium">Toca, escucha e identifica imágenes</span>
                </button>

                <!-- Tarjeta Modo 2: Adivina -->
                <button onclick="startMode('quiz')" class="bg-gradient-to-b from-cyan-400 to-blue-500 hover:from-cyan-300 hover:to-blue-400 text-white rounded-3xl p-6 shadow-xl border-4 border-white transform transition active:scale-95 flex flex-col items-center text-center group">
                    <div class="bg-white/30 rounded-2xl p-4 mb-4 transform group-hover:scale-110 transition duration-300">
                        <span class="text-6xl md:text-7xl">❓</span>
                    </div>
                    <span class="text-2xl md:text-3xl font-bold drop-shadow">Adivina la Letra</span>
                    <span class="text-sm md:text-base mt-2 opacity-90 font-medium">¿Con qué letra empieza la figura?</span>
                </button>
            </div>
        </div>

        <!-- MODO 1: Aprende Vocales y Palabras -->
        <div id="learnMode" class="hidden w-full flex-col items-center">
            <!-- Pestañas de Vocales Grande -->
            <div class="flex justify-center space-x-2 md:space-x-4 mb-6 w-full max-w-lg">
                <button onclick="selectVowel(0)" class="vowel-tab bg-red-400 text-white font-bold text-3xl md:text-4xl w-14 h-14 md:w-16 md:h-16 rounded-2xl shadow-lg border-4 border-white transform active:scale-95 transition">A</button>
                <button onclick="selectVowel(1)" class="vowel-tab bg-blue-400 text-white font-bold text-3xl md:text-4xl w-14 h-14 md:w-16 md:h-16 rounded-2xl shadow-lg border-4 border-white transform active:scale-95 transition">E</button>
                <button onclick="selectVowel(2)" class="vowel-tab bg-green-400 text-white font-bold text-3xl md:text-4xl w-14 h-14 md:w-16 md:h-16 rounded-2xl shadow-lg border-4 border-white transform active:scale-95 transition">I</button>
                <button onclick="selectVowel(3)" class="vowel-tab bg-yellow-400 text-white font-bold text-3xl md:text-4xl w-14 h-14 md:w-16 md:h-16 rounded-2xl shadow-lg border-4 border-white transform active:scale-95 transition">O</button>
                <button onclick="selectVowel(4)" class="vowel-tab bg-purple-400 text-white font-bold text-3xl md:text-4xl w-14 h-14 md:w-16 md:h-16 rounded-2xl shadow-lg border-4 border-white transform active:scale-95 transition">U</button>
            </div>

            <!-- Display de la Letra y Objeto -->
            <div class="bg-white rounded-3xl p-6 md:p-8 shadow-2xl border-4 border-yellow-300 w-full max-w-md flex flex-col items-center text-center relative overflow-hidden">
                <!-- Globo de audio al tocar -->
                <button onclick="repeatCurrentVowelSound()" class="absolute top-3 right-3 bg-slate-100 hover:bg-slate-200 p-3 rounded-full shadow text-2xl transition">
                    🔊
                </button>

                <!-- Gran Letra con Animación -->
                <div id="vowelLetter" onclick="repeatCurrentVowelSound()" class="text-7xl md:text-9xl font-black mb-2 cursor-pointer transition transform hover:scale-110 active:scale-90">
                    A
                </div>

                <!-- Ilustración SVG Dinámica o Emoji Súper Grande -->
                <div id="vowelImageContainer" onclick="repeatCurrentVowelSound()" class="w-44 h-44 md:w-52 md:h-52 my-2 flex items-center justify-center bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200 cursor-pointer transform transition hover:scale-105 active:scale-95 shadow-inner">
                    <!-- SVG insertado por Javascript -->
                </div>

                <!-- Palabra Representativa -->
                <div id="vowelWord" class="text-3xl md:text-4xl font-extrabold text-slate-700 tracking-wider mt-2">
                    Avión
                </div>

                <p class="text-slate-400 text-sm mt-3 font-semibold">¡Toca la letra o el dibujo para escuchar!</p>
            </div>

            <!-- Navegación Flechas -->
            <div class="flex justify-between w-full max-w-md mt-6 px-4">
                <button onclick="prevVowel()" class="bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-6 rounded-2xl shadow-lg border-2 border-white text-xl transform active:scale-95">
                    ⬅️ Atrás
                </button>
                <button onclick="nextVowel()" class="bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-6 rounded-2xl shadow-lg border-2 border-white text-xl transform active:scale-95">
                    Siguiente ➡️
                </button>
            </div>
        </div>

        <!-- MODO 2: Adivina la Palabra / Letra -->
        <div id="quizMode" class="hidden w-full flex-col items-center">
            <!-- Barra de Progreso o Estrellitas -->
            <div class="flex items-center space-x-2 mb-4 bg-white/80 px-6 py-2 rounded-full shadow-md border border-amber-200">
                <span class="text-lg font-bold text-amber-600">Puntos:</span>
                <div id="starContainer" class="flex space-x-1 text-2xl">
                    ⭐
                </div>
            </div>

            <!-- Tarjeta de Pregunta -->
            <div class="bg-white rounded-3xl p-6 shadow-2xl border-4 border-cyan-300 w-full max-w-md flex flex-col items-center text-center">
                <h3 id="quizQuestionText" class="text-xl md:text-2xl font-bold text-slate-700 mb-3">
                    ¿Con qué letra empieza?
                </h3>

                <!-- Objeto a Adivinar -->
                <div id="quizImageContainer" onclick="speakQuizItem()" class="w-48 h-48 md:w-56 md:h-56 my-2 flex items-center justify-center bg-cyan-50 rounded-2xl border-4 border-cyan-100 shadow-inner cursor-pointer transform transition hover:scale-105 active:scale-95">
                    <!-- Contenido SVG dinámico -->
                </div>

                <div id="quizWordHint" class="text-2xl font-extrabold text-slate-400 tracking-widest my-2">
                    _ _ _ _
                </div>

                <!-- Opciones de Botones Grandes -->
                <div id="quizOptions" class="grid grid-cols-2 gap-4 w-full mt-4">
                    <!-- Generado dinámicamente con JS -->
                </div>
            </div>
        </div>

    </main>

    <!-- Barra Inferior de Control (Regresar) -->
    <footer class="w-full p-4 flex justify-center max-w-4xl mx-auto">
        <button id="backToMenuBtn" onclick="showMenu()" class="hidden bg-slate-700 hover:bg-slate-800 text-white font-bold py-3 px-8 rounded-full shadow-lg border-2 border-white transition transform active:scale-95 text-lg flex items-center space-x-2">
            <span>🏠</span>
            <span>Inicio</span>
        </button>
    </footer>

    <!-- LÓGICA DEL JUEGO CON JAVASCRIPT -->
    <script>
        /* --- BASE DE DATOS DE VOCALES Y DIBUJOS SVG --- */
        const vowelsData = [
            {
                letter: 'A',
                word: 'Avión',
                color: 'text-red-500',
                bgColor: 'bg-red-500',
                svg: `<svg viewBox="0 0 100 100" class="w-36 h-36 drop-shadow-md">
                        <path d="M10,50 L40,45 L48,15 C49,10 51,10 52,15 L60,45 L90,50 C95,51 95,55 90,56 L60,60 L55,85 L62,90 C64,91 63,94 60,94 L50,90 L40,94 C37,94 36,91 38,90 L45,85 L40,60 L10,56 C5,55 5,51 10,50 Z" fill="#EF4444"/>
                        <circle cx="50" cy="35" r="4" fill="#FEF08A"/>
                        <path d="M20,52 L35,50" stroke="#DC2626" stroke-width="2" stroke-linecap="round"/>
                      </svg>`
            },
            {
                letter: 'E',
                word: 'Elefante',
                color: 'text-blue-500',
                bgColor: 'bg-blue-500',
                svg: `<svg viewBox="0 0 100 100" class="w-36 h-36 drop-shadow-md">
                        <!-- Cuerpo Elefante -->
                        <rect x="25" y="35" width="50" height="40" rx="15" fill="#3B82F6"/>
                        <circle cx="35" cy="40" r="18" fill="#60A5FA"/>
                        <!-- Oreja Grande -->
                        <ellipse cx="22" cy="42" rx="10" ry="14" fill="#93C5FD"/>
                        <!-- Ojito -->
                        <circle cx="38" cy="36" r="3" fill="#1E3A8A"/>
                        <circle cx="39" cy="35" r="1" fill="#FFFFFF"/>
                        <!-- Trompa -->
                        <path d="M48,45 Q60,45 58,60 Q56,70 50,68" fill="none" stroke="#3B82F6" stroke-width="7" stroke-linecap="round"/>
                        <!-- Patas -->
                        <rect x="30" y="68" width="10" height="18" rx="4" fill="#1D4ED8"/>
                        <rect x="58" y="68" width="10" height="18" rx="4" fill="#1D4ED8"/>
                      </svg>`
            },
            {
                letter: 'I',
                word: 'Isla',
                color: 'text-green-500',
                bgColor: 'bg-green-500',
                svg: `<svg viewBox="0 0 100 100" class="w-36 h-36 drop-shadow-md">
                        <!-- Mar -->
                        <path d="M5,80 Q25,75 50,80 T95,80 L95,95 L5,95 Z" fill="#38BDF8"/>
                        <!-- Arena / Isla -->
                        <ellipse cx="50" cy="80" rx="35" ry="10" fill="#FDE047"/>
                        <!-- Tronco Palmera -->
                        <path d="M48,80 Q42,55 52,35" stroke="#854D0E" stroke-width="6" fill="none" stroke-linecap="round"/>
                        <!-- Hojas Palmera -->
                        <path d="M52,35 Q30,25 20,35" stroke="#22C55E" stroke-width="5" fill="none" stroke-linecap="round"/>
                        <path d="M52,35 Q70,25 80,35" stroke="#22C55E" stroke-width="5" fill="none" stroke-linecap="round"/>
                        <path d="M52,35 Q50,15 55,10" stroke="#15803D" stroke-width="5" fill="none" stroke-linecap="round"/>
                        <!-- Sol -->
                        <circle cx="80" cy="25" r="10" fill="#FACC15"/>
                      </svg>`
            },
            {
                letter: 'O',
                word: 'Oso',
                color: 'text-amber-500',
                bgColor: 'bg-amber-500',
                svg: `<svg viewBox="0 0 100 100" class="w-36 h-36 drop-shadow-md">
                        <!-- Orejas -->
                        <circle cx="30" cy="28" r="10" fill="#B45309"/>
                        <circle cx="30" cy="28" r="6" fill="#FDE68A"/>
                        <circle cx="70" cy="28" r="10" fill="#B45309"/>
                        <circle cx="70" cy="28" r="6" fill="#FDE68A"/>
                        <!-- Cabeza -->
                        <circle cx="50" cy="45" r="28" fill="#D97706"/>
                        <!-- Hocico -->
                        <ellipse cx="50" cy="52" rx="14" ry="10" fill="#FEF3C7"/>
                        <ellipse cx="50" cy="48" rx="6" ry="4" fill="#451A03"/>
                        <!-- Ojos -->
                        <circle cx="40" cy="40" r="3" fill="#451A03"/>
                        <circle cx="60" cy="40" r="3" fill="#451A03"/>
                        <!-- Cuerpo -->
                        <path d="M28,68 C28,60 72,60 72,68 L75,90 L25,90 Z" fill="#D97706"/>
                      </svg>`
            },
            {
                letter: 'U',
                word: 'Uva',
                color: 'text-purple-500',
                bgColor: 'bg-purple-500',
                svg: `<svg viewBox="0 0 100 100" class="w-36 h-36 drop-shadow-md">
                        <!-- Tallo -->
                        <path d="M50,15 Q55,5 65,10" stroke="#15803D" stroke-width="4" fill="none" stroke-linecap="round"/>
                        <path d="M50,15 L50,25" stroke="#854D0E" stroke-width="4"/>
                        <!-- Hoja -->
                        <path d="M50,20 Q35,10 38,25 Z" fill="#22C55E"/>
                        <!-- Uvas (Racimo) -->
                        <circle cx="40" cy="33" r="10" fill="#A855F7"/>
                        <circle cx="60" cy="33" r="10" fill="#9333EA"/>
                        <circle cx="50" cy="45" r="10" fill="#A855F7"/>
                        <circle cx="35" cy="55" r="10" fill="#7E22CE"/>
                        <circle cx="65" cy="55" r="10" fill="#A855F7"/>
                        <circle cx="50" cy="65" r="10" fill="#9333EA"/>
                        <circle cx="50" cy="80" r="9" fill="#7E22CE"/>
                        <!-- Brillos -->
                        <circle cx="37" cy="30" r="2" fill="#FFFFFF" opacity="0.6"/>
                        <circle cx="47" cy="42" r="2" fill="#FFFFFF" opacity="0.6"/>
                      </svg>`
            }
        ];

        /* --- ESTADO DEL JUEGO --- */
        let currentMode = 'menu'; // 'menu', 'learn', 'quiz'
        let currentVowelIndex = 0;
        let quizCurrentItem = null;
        let score = 0;
        let isAudioPlaying = false;
        let bgAudioContext = null;
        let bgOscillator = null;

        /* --- SINTETIZADOR DE VOZ (SpeechSynthesis) --- */
        function speak(text, rate = 0.85) {
            if ('speechSynthesis' in window) {
                // Cancelar audios anteriores
                window.speechSynthesis.cancel();
                
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'es-ES';
                utterance.rate = rate; // Velocidad pausada para niños
                utterance.pitch = 1.2; // Tono alegre y juvenil

                // Intentar obtener voz en español de mejor calidad
                const voices = window.speechSynthesis.getVoices();
                const esVoice = voices.find(v => v.lang.startsWith('es'));
                if (esVoice) utterance.voice = esVoice;

                window.speechSynthesis.speak(utterance);
            }
        }

        /* --- WEB AUDIO API (Efectos de sonido interactivos) --- */
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSoundEffect(type) {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'success') {
                // Sonido de victoria/acierto alegre (Arpegio ascendente)
                const now = audioCtx.currentTime;
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(300, now);
                osc.frequency.exponentialRampToValueAtTime(600, now + 0.1);
                osc.frequency.exponentialRampToValueAtTime(900, now + 0.25);
                
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);

                osc.start(now);
                osc.stop(now + 0.4);
            } else if (type === 'pop') {
                // Pop suave al presionar botones
                const now = audioCtx.currentTime;
                osc.type = 'sine';
                osc.frequency.setValueAtTime(400, now);
                osc.frequency.exponentialRampToValueAtTime(800, now + 0.08);

                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);

                osc.start(now);
                osc.stop(now + 0.08);
            } else if (type === 'tryAgain') {
                // Tono suave para reintentar (sin asustar)
                const now = audioCtx.currentTime;
                osc.type = 'sine';
                osc.frequency.setValueAtTime(280, now);
                osc.frequency.linearRampToValueAtTime(220, now + 0.2);

                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);

                osc.start(now);
                osc.stop(now + 0.2);
            }
        }

        /* --- MÚSICA DE FONDO RELAJANTE Y SIMPLE --- */
        function toggleAudio() {
            playSoundEffect('pop');
            const soundBtn = document.getElementById('soundToggleBtn');
            const soundIcon = document.getElementById('soundIcon');

            if (!isAudioPlaying) {
                startBackgroundMusic();
                isAudioPlaying = true;
                soundBtn.classList.remove('bg-yellow-400');
                soundBtn.classList.add('bg-green-400');
                soundIcon.textContent = '🎶';
            } else {
                stopBackgroundMusic();
                isAudioPlaying = false;
                soundBtn.classList.remove('bg-green-400');
                soundBtn.classList.add('bg-yellow-400');
                soundIcon.textContent = '🔊';
            }
        }

        let bgInterval = null;
        function startBackgroundMusic() {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            // Secuencia muy suave y melodiosa para niños
            const notes = [261.63, 329.63, 392.00, 523.25, 392.00, 329.63]; // C4, E4, G4, C5, G4, E4
            let noteIdx = 0;

            bgInterval = setInterval(() => {
                if (!isAudioPlaying) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.type = 'sine';
                osc.frequency.setValueAtTime(notes[noteIdx], audioCtx.currentTime);
                
                gain.gain.setValueAtTime(0.03, audioCtx.currentTime); // Volumen muy bajo y sutil
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.6);

                osc.start();
                osc.stop(audioCtx.currentTime + 0.6);

                noteIdx = (noteIdx + 1) % notes.length;
            }, 700);
        }

        function stopBackgroundMusic() {
            if (bgInterval) clearInterval(bgInterval);
        }

        /* --- GESTIÓN DE MODOS DE JUEGO --- */
        function startMode(mode) {
            playSoundEffect('pop');
            currentMode = mode;
            document.getElementById('modeSelection').classList.add('hidden');
            document.getElementById('backToMenuBtn').classList.remove('hidden');

            if (mode === 'learn') {
                document.getElementById('learnMode').classList.remove('hidden');
                document.getElementById('learnMode').classList.add('flex');
                selectVowel(0);
                speak("¡Aprendamos las vocales!");
            } else if (mode === 'quiz') {
                document.getElementById('quizMode').classList.remove('hidden');
                document.getElementById('quizMode').classList.add('flex');
                score = 0;
                updateStarDisplay();
                loadNewQuizQuestion();
                speak("¡Adivina con qué letra empieza!");
            }
        }

        function showMenu() {
            playSoundEffect('pop');
            currentMode = 'menu';
            document.getElementById('learnMode').classList.add('hidden');
            document.getElementById('learnMode').classList.remove('flex');
            document.getElementById('quizMode').classList.add('hidden');
            document.getElementById('quizMode').classList.remove('flex');
            document.getElementById('modeSelection').classList.remove('hidden');
            document.getElementById('backToMenuBtn').classList.add('hidden');
        }

        /* --- MODO 1: APRENDE VOCALES --- */
        function selectVowel(index) {
            currentVowelIndex = index;
            const data = vowelsData[index];

            // Actualizar interfaz
            const letterElem = document.getElementById('vowelLetter');
            letterElem.textContent = data.letter;
            letterElem.className = `text-7xl md:text-9xl font-black mb-2 cursor-pointer transition transform hover:scale-110 active:scale-90 ${data.color} bouncy`;

            document.getElementById('vowelImageContainer').innerHTML = data.svg;
            document.getElementById('vowelWord').textContent = data.word;

            // Resaltar pestaña activa
            const tabs = document.querySelectorAll('.vowel-tab');
            tabs.forEach((tab, i) => {
                if (i === index) {
                    tab.classList.add('ring-4', 'ring-purple-600', 'scale-110');
                } else {
                    tab.classList.remove('ring-4', 'ring-purple-600', 'scale-110');
                }
            });

            // Reproducir pronunciación
            repeatCurrentVowelSound();
        }

        function repeatCurrentVowelSound() {
            playSoundEffect('pop');
            const data = vowelsData[currentVowelIndex];
            // Pronuncia la letra y luego la palabra
            speak(`${data.letter}... de ${data.word}`);
        }

        function nextVowel() {
            const nextIdx = (currentVowelIndex + 1) % vowelsData.length;
            selectVowel(nextIdx);
        }

        function prevVowel() {
            const prevIdx = (currentVowelIndex - 1 + vowelsData.length) % vowelsData.length;
            selectVowel(prevIdx);
        }

        /* --- MODO 2: ADIVINA LA PALABRA / LETRA --- */
        function loadNewQuizQuestion() {
            // Seleccionar un elemento al azar
            const randomIdx = Math.floor(Math.random() * vowelsData.length);
            quizCurrentItem = vowelsData[randomIdx];

            // Mostrar el SVG correspondiente
            document.getElementById('quizImageContainer').innerHTML = quizCurrentItem.svg;
            
            // Pista de palabra (ej: A _ _ _ _)
            const word = quizCurrentItem.word;
            const hint = word.charAt(0) + ' ' + '_ '.repeat(word.length - 1);
            document.getElementById('quizWordHint').textContent = hint;

            // Generar Opciones (3 opciones)
            const optionsContainer = document.getElementById('quizOptions');
            optionsContainer.innerHTML = '';

            // Crear lista con la respuesta correcta y otras 2 incorrectas
            let options = [quizCurrentItem.letter];
            let availableWrong = vowelsData.filter(v => v.letter !== quizCurrentItem.letter);
            
            // Mezclar y tomar 1 o 2 incorrectos
            availableWrong.sort(() => 0.5 - Math.random());
            options.push(availableWrong[0].letter);
            if (availableWrong[1]) {
                options.push(availableWrong[1].letter);
            }

            // Desordenar las opciones
            options.sort(() => 0.5 - Math.random());

            // Crear botones de respuesta súper grandes
            options.forEach(letter => {
                const btn = document.createElement('button');
                btn.className = 'bg-gradient-to-b from-amber-300 to-yellow-400 hover:from-amber-200 hover:to-yellow-300 text-slate-800 font-extrabold text-4xl py-5 rounded-2xl shadow-lg border-4 border-white transform active:scale-95 transition flex justify-center items-center';
                btn.textContent = letter;
                btn.onclick = () => checkQuizAnswer(letter, btn);
                optionsContainer.appendChild(btn);
            });

            // Pronunciar la indicación
            setTimeout(() => {
                speak(`¿Con qué letra empieza ${quizCurrentItem.word}?`);
            }, 300);
        }

        function speakQuizItem() {
            if (quizCurrentItem) {
                speak(quizCurrentItem.word);
            }
        }

        function checkQuizAnswer(selectedLetter, btnElement) {
            if (selectedLetter === quizCurrentItem.letter) {
                // --- RESPUESTA CORRECTA ---
                playSoundEffect('success');
                btnElement.classList.remove('from-amber-300', 'to-yellow-400');
                btnElement.classList.add('bg-green-500', 'text-white', 'pulse-slow');

                // Confeti festivo
                confetti({
                    particleCount: 70,
                    spread: 60,
                    origin: { y: 0.6 }
                });

                score++;
                updateStarDisplay();

                const praises = ["¡Muy bien!", "¡Excelente!", "¡Lo hiciste genial!", "¡Fantástico!"];
                const randomPraise = praises[Math.floor(Math.random() * praises.length)];
                speak(`${randomPraise} ${quizCurrentItem.letter} de ${quizCurrentItem.word}`);

                // Siguiente pregunta tras pequeña pausa
                setTimeout(() => {
                    loadNewQuizQuestion();
                }, 2200);

            } else {
                // --- RESPUESTA INCORRECTA (Sin frustración) ---
                playSoundEffect('tryAgain');
                btnElement.classList.add('shake', 'opacity-50');
                
                speak("¡Inténtalo de nuevo!", 0.9);

                setTimeout(() => {
                    btnElement.classList.remove('shake');
                }, 600);
            }
        }

        function updateStarDisplay() {
            const container = document.getElementById('starContainer');
            container.innerHTML = '⭐'.repeat(Math.min(score, 5)) || '✨';
        }

        // Cargar lista de voces si el navegador lo requiere
        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = () => {
                window.speechSynthesis.getVoices();
            };
        }
    </script>
</body>
